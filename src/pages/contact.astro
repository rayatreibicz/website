---
import PageWayfinding from '../components/PageWayfinding.astro';
import InteriorLayout from '../layouts/InteriorLayout.astro';
---
<InteriorLayout title='Contact | Raya Maia' description='Have a question, an idea, or just want to say hello? Get in touch with Raya Maia.' pageClass='page-contact' canonicalPath='/contact/'>
<main>
<div class="page-shell">
<PageWayfinding position="top" />
<section class="sky-hero">
<div class="sky-hero-copy reveal">
<p class="kicker">
              Contact
            </p>
<h1>
              Every conversation starts somewhere.
            </h1>
<p class="lede">
              Whether you have a question, an idea, or just want to say hello, I'd love to hear from you.
            </p>
<a class="contact-email" href="mailto:hello@rayamaia.com">hello@rayamaia.com</a>
<div class="contact-links">
<a href="https://www.linkedin.com/in/raya-treibicz/" rel="noopener" target="_blank">LinkedIn ↗</a>
<a href="https://rayamaia.substack.com" rel="noopener" target="_blank">The Human Question ↗</a>
</div>
</div>
</section>
</div>
</main>
</InteriorLayout>
