---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import StarDivider from '../../components/StarDivider.astro';
import PageWayfinding from '../../components/PageWayfinding.astro';
import FactStrip from '../../components/FactStrip.astro';
import ProjectLog from '../../components/ProjectLog.astro';
import LocalDemoPlayer from '../../components/LocalDemoPlayer.astro';
import LocalEvolutionCarousel from '../../components/LocalEvolutionCarousel.astro';
import LocalEvaluation from '../../components/LocalEvaluation.astro';

const progress = [
  {
    date: '2026-10-27',
    text: 'Connected the redesigned interface to Local’s backend, tested core functionality, and identified bugs for further refinement.',
  },
  {
    date: '2026-10-23',
    text: 'Developed a new PySide6 interface with animated navigation, resizable multi-panel workspaces, improved chat functionality, and integrated approval dialogs.',
  },
  {
    date: '2026-10-20',
    text: 'Integrated Gmail and Google Calendar across multiple accounts, added email retrieval and batch summarization, implemented calendar event management, and refined approval-based workflows and persistent memory.',
  },
  {
    date: '2026-10-13',
    text: 'Moved from Gemma to Qwen3 after retrieval failures, implemented persistent memory, and integrated Obsidian task management with natural-language creation, retrieval, and classification.',
  },
  {
    date: '2026-10-07',
    text: 'Integrated Gemma 4 via local Ollama inference, built a Python tool-calling agent with limited file access, and developed a PySide6 desktop interface with SQLite conversation history, automatic titles, chat management, and Markdown rendering.',
  },
  {
    date: '2026-10-03',
    text: 'Established the initial goals, parameters, and constraints for a local agent.',
  },
];

const evolution = [
  {
    date: 'October 7, 2026',
    heading: 'It started in a terminal.',
    description: 'The first version ran local inference through Ollama and used a Python tool to search personal knowledge. No desktop interface yet.',
    images: [
      { src: '/local/evolution/01-terminal-agent.png', alt: 'PowerShell showing the early Local agent using a search_knowledge tool to answer a question about robotics.', label: 'Terminal prototype' },
    ],
  },
  {
    date: 'October 13, 2026',
    heading: 'Changing the model, not the whole system.',
    description: 'The same retrieval question produced an unrelated response from Gemma; Qwen3 made a more relevant, though still incomplete, attempt to use the notes. The comparison helped motivate a model change.',
    images: [
      { src: '/local/evolution/02-gemma-retrieval.png', alt: 'Gemma answering an interview-history question with an unrelated response about favourite food.', label: 'Gemma · off-topic answer' },
      { src: '/local/evolution/03-qwen-retrieval.png', alt: 'Qwen3 examining available interview-related notes but not finding a definitive answer.', label: 'Qwen3 · grounded attempt' },
    ],
  },
  {
    date: 'October 13, 2026',
    heading: 'Memory, subject to review.',
    description: 'A review dialog lets the user accept or reject proposed updates to persistent memory rather than silently accepting every extracted preference.',
    images: [
      { src: '/local/evolution/04-memory-review.png', alt: 'Local suggested-memories dialog showing a proposed colour preference update, a new dark-mode preference, and approval or rejection controls.', label: 'Memory approval dialog' },
    ],
  },
  {
    date: 'October 19, 2026',
    heading: 'From information to action.',
    description: 'An email summary led to a follow-up request and a task created in Obsidian: a cross-tool workflow rather than a standalone chat response.',
    images: [
      { src: '/local/evolution/05-email-task.png', alt: 'Local summarizes action items from a professional inbox, then confirms creating an Obsidian task after a follow-up request. Sensitive details are redacted.', label: 'Email-to-task workflow' },
    ],
  },
  {
    date: 'October 20, 2026',
    heading: 'Scheduling with context.',
    description: 'Calendar creation began accounting for existing commitments and personal spacing preferences. This snapshot also captures a judgment problem that later evaluations helped identify.',
    images: [
      { src: '/local/evolution/06-calendar-review.png', alt: 'Local discusses a dentist appointment, neighboring commitments, and creating a calendar event. The event URL has been redacted.', label: 'Calendar scheduling' },
    ],
  },
];
---
<InteriorLayout
  title="Homegrown Intelligence · Local | Raya Maia"
  description="Local is a privacy-first desktop AI agent built with Python, PySide6, Ollama and local inference, with controlled access to personal tools and data."
  pageClass="page-local-agent"
  canonicalPath="/projects/local-agent/"
>
  <main>
    <div class="page-shell">
      <PageWayfinding position="top" />

      <section class="sky-hero local-hero">
        <div class="sky-hero-copy reveal">
          <p class="kicker">Local Agent</p>
          <h1>Homegrown Intelligence</h1>
          <p class="lede">Meet Local — an experiment in building a private, locally run AI agent around my own tools, data, and workflows.</p>
          <div class="local-technology-tags" aria-label="Technology stack">
            {['Python', 'PySide6', 'SQLite', 'Ollama', 'Qwen3', 'Google APIs'].map(tag => <span>{tag}</span>)}
          </div>
        </div>
      </section>

      <LocalDemoPlayer src="/local/local-demo-v1.mp4" poster="/local/local-demo-poster.jpg" description="A recorded demonstration of Local's multi-panel desktop interface, conversation and task panels, memory review, and calendar approval workflow." />

      <StarDivider />

      <section class="field-section" aria-labelledby="local-design-heading">
        <div class="field-layout">
          <aside class="field-index reveal"><strong>01</strong>Design principles</aside>
          <div class="field-content reveal">
            <h2 id="local-design-heading">Built for the real world.</h2>
            <p class="lead">Making a smaller local model useful on consumer hardware.</p>
            <p>Local uses Python tools to work with knowledge, tasks, calendars and email. The model handles language and interpretation while the surrounding application manages persistent data, tool access and reviewable actions. This separation lets me change models without rebuilding the rest of the system.</p>
            <div class="observation-list local-principles">
              <div class="observation"><span class="dot"></span><div><h3>Keep local and cloud models separate.</h3><p>Use cloud models when more advanced reasoning is needed, but decide myself what context crosses between them.</p></div></div>
              <div class="observation"><span class="dot"></span><div><h3>Build for a personal computer.</h3><p>Design around hardware I can realistically own and run at home.</p></div></div>
              <div class="observation"><span class="dot"></span><div><h3>Keep models replaceable.</h3><p>Store knowledge, memory and tools outside the model so I can change models without rebuilding the agent.</p></div></div>
              <div class="observation"><span class="dot"></span><div><h3>Solve real problems without outsourcing judgment.</h3><p>Build around what gets in my way. Let Local notice and suggest, while meaningful decisions remain mine.</p></div></div>
            </div>
            <FactStrip items={[
              { label: 'Hardware', title: 'Limited resources.', text: 'The model shares RAM and VRAM with everything else on my computer. I prioritize improving efficiency before upgrading hardware.' },
              { label: 'Availability', title: 'Not always on.', text: 'When my computer sleeps, Local is unavailable. I accept that instead of maintaining a permanent server.' },
              { label: 'Maintenance', title: 'Keeping it simple.', text: 'Modular architecture helps me maintain and extend Local without spending excessive time on upkeep.' },
            ]} />
          </div>
        </div>
      </section>

      <section class="field-section" aria-labelledby="local-privacy-heading">
        <div class="field-layout">
          <aside class="field-index reveal"><strong>02</strong>Privacy & safety</aside>
          <div class="field-content reveal">
            <h2 id="local-privacy-heading">Access should be deliberate.</h2>
            <p class="lead">Keeping inference local is an important starting point but not a complete security model.</p>
            <p>Local runs its language model through Ollama on my computer. Connecting to Gmail or Google Calendar still involves external services, so the important questions are what the tools can access, what information is shared, and which actions require confirmation.</p>
            <div class="local-permissions-wrap">
              <p class="micro-label">Current integration boundaries</p>
              <div class="local-table-scroll" role="region" aria-label="Local permissions and approval table" tabindex="0">
                <table class="local-data-table local-permissions-table">
                  <thead><tr><th scope="col">Surface</th><th scope="col">Use</th><th scope="col">Control / boundary</th></tr></thead>
                  <tbody>
                    <tr><th scope="row">Local files</th><td>Search notes</td><td>Restricted folders</td></tr>
                    <tr><th scope="row">Memory</th><td>Suggest updates</td><td>Approval required</td></tr>
                    <tr><th scope="row">Obsidian tasks</th><td>Read and edit tasks</td><td>Structured tools; duplicate checks</td></tr>
                    <tr><th scope="row">Google Calendar</th><td>Read and create events</td><td>Review before creation; no deletion</td></tr>
                    <tr><th scope="row">Gmail</th><td>Read and summarize</td><td>Selected accounts; no sending</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
            <div class="local-boundary-note">
              <p class="micro-label">Engineering principle</p>
              <p>Language-model output is not a permission system. Sensitive operations should be constrained by code and explicit user decisions, not by the model's confidence. This is an evolving personal prototype, not a claim of completed security certification.</p>
            </div>
          </div>
        </div>
      </section>

      <StarDivider />

      <section class="field-section local-deep-dive" aria-labelledby="local-deep-heading">
        <div class="field-layout">
          <aside class="field-index reveal"><strong>03</strong>Deep dive</aside>
          <div class="field-content reveal">
            <h2 id="local-deep-heading">What changed along the way.</h2>
            <LocalEvolutionCarousel slides={evolution} />
            <div class="local-evaluation-heading">
              <p class="micro-label">Evidence, not just a demo</p>
              <h2>Evaluation & results.</h2>
              <p>A small, deliberately practical test suite helped me decide what to improve, including when a correct action was paired with an incorrect explanation.</p>
            </div>
            <LocalEvaluation />
          </div>
        </div>
      </section>

      <ProjectLog entries={progress} />
      <PageWayfinding position="bottom" />
    </div>
  </main>
</InteriorLayout>
