---
interface Props {
  src: string;
  poster: string;
  description?: string;
}
const { src, poster, description = 'Recorded demonstration of Local, the privacy-first desktop AI agent.' } = Astro.props;
---
<section class="local-demo" aria-label="Local desktop assistant demonstration" data-local-demo>
  <div class="local-demo-frame">
    <video
      class="local-demo-video"
      src={src}
      poster={poster}
      aria-label={description}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      Your browser cannot play the embedded video. <a href={src}>Open the recording instead.</a>
    </video>
  </div>
  <div class="local-video-controls" aria-label="Video playback controls">
    <div class="local-video-actions">
      <button class="local-video-button" type="button" data-frame-back title="Previous frame" aria-label="Previous frame">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5v14M19 5 9 12l10 7V5Z" /></svg>
      </button>
      <button class="local-video-button local-video-main" type="button" data-play-pause title="Pause demonstration" aria-label="Pause demonstration">
        <svg data-icon-pause viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
        <svg data-icon-play viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m8 5 11 7-11 7V5Z" /></svg>
      </button>
      <button class="local-video-button" type="button" data-frame-next title="Next frame" aria-label="Next frame">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 5v14M5 5l10 7-10 7V5Z" /></svg>
      </button>
      <button class="local-video-button local-sound-toggle" type="button" data-sound title="Unmute demonstration" aria-label="Unmute demonstration">
        <svg data-icon-muted viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5ZM16 9l5 6m0-6-5 6" /></svg>
        <svg data-icon-sound viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M11 5 6 9H3v6h3l5 4V5ZM15 9c1.5 1.5 1.5 4.5 0 6M18 6c3.2 3.2 3.2 8.8 0 12" /></svg>
      </button>
    </div>
    <div class="local-video-timeline">
      <label class="sr-only" for="local-video-seek">Position in demonstration</label>
      <input id="local-video-seek" type="range" min="0" max="100" step="0.001" value="0" data-seek aria-label="Seek through demonstration" />
      <output class="local-video-time" data-time aria-live="off">0:00 / 1:39</output>
    </div>
  </div>
  <p class="local-mobile-video-note">For the clearest view of the interface, watch this demonstration on a computer.</p>
</section>

<script>
  const FRAME_SECONDS = 1 / 30;
  for (const player of document.querySelectorAll<HTMLElement>('[data-local-demo]')) {
    const video = player.querySelector<HTMLVideoElement>('video');
    const playButton = player.querySelector<HTMLButtonElement>('[data-play-pause]');
    const back = player.querySelector<HTMLButtonElement>('[data-frame-back]');
    const next = player.querySelector<HTMLButtonElement>('[data-frame-next]');
    const sound = player.querySelector<HTMLButtonElement>('[data-sound]');
    const seek = player.querySelector<HTMLInputElement>('[data-seek]');
    const time = player.querySelector<HTMLOutputElement>('[data-time]');
    if (!video || !playButton || !back || !next || !sound || !seek || !time) continue;

    const clock = (seconds: number) => {
      const total = Math.max(0, Math.floor(Number.isFinite(seconds) ? seconds : 0));
      return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
    };
    const refresh = () => {
      const duration = Number.isFinite(video.duration) ? video.duration : 99;
      const playing = !video.paused && !video.ended;
      playButton.querySelector<SVGElement>('[data-icon-pause]')!.hidden = !playing;
      playButton.querySelector<SVGElement>('[data-icon-play]')!.hidden = playing;
      playButton.title = playing ? 'Pause demonstration' : 'Play demonstration';
      playButton.setAttribute('aria-label', playing ? 'Pause demonstration' : 'Play demonstration');
      sound.querySelector<SVGElement>('[data-icon-muted]')!.hidden = !video.muted;
      sound.querySelector<SVGElement>('[data-icon-sound]')!.hidden = video.muted;
      sound.title = video.muted ? 'Unmute demonstration' : 'Mute demonstration';
      sound.setAttribute('aria-label', video.muted ? 'Unmute demonstration' : 'Mute demonstration');
      seek.max = String(duration);
      seek.value = String(video.currentTime);
      time.textContent = `${clock(video.currentTime)} / ${clock(duration)}`;
    };
    const step = (offset: number) => {
      video.pause();
      const max = Number.isFinite(video.duration) ? Math.max(0, video.duration - FRAME_SECONDS) : Infinity;
      video.currentTime = Math.min(max, Math.max(0, video.currentTime + offset * FRAME_SECONDS));
      refresh();
    };
    playButton.addEventListener('click', () => {
      if (video.paused) void video.play().catch(() => refresh());
      else video.pause();
      refresh();
    });
    back.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    sound.addEventListener('click', () => { video.muted = !video.muted; refresh(); });
    seek.addEventListener('input', () => { video.currentTime = Number(seek.value); refresh(); });
    for (const name of ['loadedmetadata', 'durationchange', 'timeupdate', 'play', 'pause', 'seeked', 'volumechange']) {
      video.addEventListener(name, refresh);
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) video.pause();
    refresh();
  }
</script>
