---
import { localCheckpoints, localTests, localObservations } from '../data/local-evaluation';
const latest = localTests.map(test => ({ ...test, latest: Number(test.scores[4]) }));
const scoreText = (score: number | null) => score === null ? '—' : String(score);
---
<div class="local-evaluation">
  <div class="local-eval-summary">
    <div class="local-eval-intro">
      <p>
        I tested Local on questions and actions drawn from its intended use: retrieving files,
        resisting false premises, creating tasks, interpreting calendars, and summarizing emails.
      </p>

      <p>Each recorded result is scored:</p>

      <ul>
        <li><strong>1</strong> — Correct and grounded</li>
        <li><strong>0.5</strong> — Partially correct</li>
        <li><strong>0</strong> — Incorrect, fabricated, or failed</li>
      </ul>
      <p class="local-eval-caveat">These are individual development checkpoints, not statistically measured reliability rates. The test suite expanded as new capabilities were introduced.</p>
    </div>
    <figure class="local-chart-card local-chart-card-bars">
      <figcaption>
        <h3>Latest capability scores</h3>
        <p>One recorded evaluation per capability on a 0–1 scale.</p>
      </figcaption>
      <div class="local-score-list">
        {latest.map(item => (
          <div class="local-score-row">
            <span class="local-score-name">{item.capability}</span>
            <div class="local-score-track" aria-hidden="true"><span style={`width:${item.latest * 100}%`}></span></div>
            <span class="local-score-number">{item.latest.toFixed(1)}</span>
          </div>
        ))}
      </div>
      <p class="local-chart-footnote">A score of 1 means the tested response passed, not that the capability works perfectly every time.</p>
    </figure>
  </div>

  <div class="local-eval-details">
    <h3>The test cases</h3>
    <div class="local-table-scroll" role="region" aria-label="Evaluation test framework" tabindex="0">
      <table class="local-data-table local-framework-table">
        <thead><tr><th scope="col">ID / capability</th><th scope="col">Test prompt</th><th scope="col">Expected behaviour</th><th scope="col">Source</th></tr></thead>
        <tbody>
          {localTests.map(test => (
            <tr>
              <th scope="row"><span class="local-test-id">{test.id}</span> {test.capability}</th>
              <td>{test.prompt}</td><td>{test.expected}</td><td>{test.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h3>Recorded scores</h3>
    <div class="local-table-scroll" role="region" aria-label="Evaluation scores by checkpoint" tabindex="0">
      <table class="local-data-table local-results-table">
        <thead><tr><th scope="col">Scenario</th>{localCheckpoints.map(cp => <th scope="col"><span>{cp.label}</span><small>{cp.model}</small></th>)}</tr></thead>
        <tbody>
          {localTests.map(test => (
            <tr><th scope="row">{test.id} · {test.capability}</th>{test.scores.map(score => <td class:list={[score === null && 'local-not-tested', score === 1 && 'local-full-score']}>{scoreText(score)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="local-eval-table-note">— = not yet tested. Scores reflect the behaviour of Local at each checkpoint, not an isolated model benchmark.</p>
  </div>

  <div class="local-eval-findings">
    <div>
      <p class="micro-label">What the tests revealed</p>
      <h3>Useful data points.</h3>
      <p>The switch from Gemma to Qwen3 on October 13 followed repeated retrieval failures. Later tests surfaced different problems: incomplete answers, incorrect reporting of completed actions, and scheduling judgments that treated a preference as a conflict.</p>
    </div>
    <div class="local-findings-list">
      {localObservations.map(item => (
        <div class="local-finding">
          <span>{item.when} / {item.label}</span>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</div>
