---
import '../styles/global.css';
import CursorTrail from '../components/CursorTrail.astro';
interface Props { title: string; description: string; canonicalPath?: string; bodyClass?: string; }
const { title, description, canonicalPath = Astro.url.pathname, bodyClass = '' } = Astro.props;
const canonical = new URL(canonicalPath, 'https://rayamaia.com').toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Raya Maia Lai Treibicz" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raya Maia" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#f4efe4" />
  </head>
  <body class={bodyClass}><slot /><CursorTrail /></body>
</html>
